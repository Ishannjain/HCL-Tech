# Copy to .env. Never commit your .env or API keys.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_KEY=
# Set false after adding your key. Mock runs are explicitly labeled.
MOCK_LLM=true
RETRIEVAL_BACKEND=chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=8
# Required for mutation endpoints and privileged audit access.
ADMIN_API_KEY=
TIMEZONE=Asia/Kolkata
